<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<!-- This is a place for minor or overridden changes to internal carrier configuration values.
     The format and filtering rules are the same as those in carrier_config*.xml files.
     This file is read after any specific configuration file from the assets folder,
     so it must use explicit filters for MCC ad MNC if that is desired. -->
<carrier_config_list>
    <!-- South Korea: LG U+ (MCC 450, MNC 06 / Carrier ID 1892) -->
    <carrier_config mcc="450" mnc="06">
        <boolean name="ims.allow_sip_p_access_network_info_header_in_initial_register_bool" value="true" />
        <boolean name="ims.allow_algorithm_param_in_sip_authorization_header_bool" value="true" />
        <int name="ims.registration_contact_user_info_part_int" value="1" />
        <string name="ims.ims_user_agent_string">TTA-VoLTE/3.0 #MODEL#/#BUILD# Device-Type/Android_Phone LGU</string>
        <int name="ims.request_uri_type_int" value="1" />
        <int name="imssms.sms_preferred_psi_uri_type_int" value="1" />
        <int name="imsvoice.policy_of_local_numbers_int" value="2" />
        <boolean name="imssms.sms_use_dialed_number_for_request_uri_bool" value="false" />
    </carrier_config>

